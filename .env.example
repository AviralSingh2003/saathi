# Copy to .env. Real environment variables take precedence over this file.

# --- mode ---
MOCK=1                 # 1 = offline deterministic router + .eml outbox; 0 = Bedrock + SES
DEMO_MODE=1            # enables the demo clock controls (/dev/clock)

# --- AWS (live mode only) — step-by-step setup: docs/aws-setup-guide.md ---
# Credentials come from `aws configure`; don't put access keys in this file.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0   # an inference profile ID (us. / global. prefix)
SES_SENDER=            # SES-verified sender, e.g. saathi@yourdomain.com
PRIYA_EMAIL=priya@example.com   # demo family contact; must be SES-verified while in the SES sandbox
# SES_REGION=          # only if SES is set up in a different region from Bedrock
# Email without SES (used only when SES_SENDER is empty), e.g. Gmail with an App password:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=       # Gmail App password (myaccount.google.com/apppasswords); needs 2-Step Verification
# SMTP_SECURITY=starttls   # or ssl (port 465) / none (a local test server such as Mailpit on port 1025)
SMS_ENABLED=0          # 1 = send texts with Amazon SNS (live mode); 0 = write them to outbox/*.sms.txt
PRIYA_PHONE=+15555550100   # demo family phone, E.164; must be verified while SNS SMS is in its sandbox
# SNS_REGION=          # only if SNS SMS is set up in a different region

# --- local services ---
MCP_HOST=127.0.0.1
MCP_PORT=8765
UI_HOST=127.0.0.1
UI_PORT=8080
POLL_SECONDS=5         # how often the host checks for due events
# UI_ORIGIN=http://127.0.0.1:8080,http://localhost:8080   # allowed browser origins (default: these)

# --- emergencies ---
EMERGENCY_NUMBER=911           # named in messages; 112 in India and the EU, 999 in the UK
CRISIS_LINE_TEXT=a crisis line such as 988   # spoken if someone may harm themselves; set per country
EMERGENCY_CHECK_TIMEOUT=10     # seconds to wait for the Haiku emergency check before asking "Are you okay?"
EMERGENCY_CONFIRM_SECONDS=30   # after asking, how long to wait for an answer before contacting emergency services
# Emergency dispatch is SIMULATED in this build (core/dispatch.py): no real emergency call is ever placed.

# --- family ---
DIGEST_TIME=19:30              # evening summary to family (email + text)

# --- storage (defaults shown) ---
# SAATHI_DB=data/saathi.db
# SAATHI_OUTBOX=outbox
# SAATHI_PEOPLE=meera:Meera,raj:Raj
